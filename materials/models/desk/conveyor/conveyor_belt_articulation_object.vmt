PBR
{
	$basetexture "models/desk/conveyor/conveyor_belt_articulation_object"
	$bumpmap "deafult/deafult_normal"
	
	$mraotexture "models/desk/conveyor/conveyor_belt_articulation_object_mrao"
	Proxies
	{
		TextureScroll
		{
			texturescrollvar "$basetexturetransform"
			texturescrollrate 0.1
			texturescrollangle 0
		}
	}
	
	$model 1	
}